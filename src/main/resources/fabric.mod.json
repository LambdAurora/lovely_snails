{
	"schemaVersion": 1,
	"id": "lovely_snails",
	"version": "${version}",
	"name": "Lovely Snails",
	"description": "Adds some big snails. Made for Modfest 1.17.",
	"authors": [
		"LambdAurora"
	],
	"contributors": [
		"Arathain",
		"Patbox",
		"Drex"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/lovely_snails",
		"sources": "https://github.com/LambdAurora/lovely_snails.git",
		"issues": "https://github.com/LambdAurora/lovely_snails/issues"
	},
	"license": "Lambda License",
	"icon": "assets/lovely_snails/icon.png",
	"environment": "*",
	"entrypoints": {
		"yumi:init": [
			"dev.lambdaurora.lovely_snails.LovelySnails"
		],
		"yumi:client_init": [
			"dev.lambdaurora.lovely_snails.client.LovelySnailsClient"
		]
	},
	"mixins": [
		"lovely_snails.mixins.json"
	],
	"assessWidener": "lovely_snails.classtweaker",
	"depends": {
		"minecraft": "~26.2",
		"fabricloader": ">=0.19.2",
		"fabric-api": ">=0.152.0+26.2",
		"java": ">=25",
		"yumi_mc_core": ">=1.1.0"
	}
}
